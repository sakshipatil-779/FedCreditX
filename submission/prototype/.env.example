# FedCreditX Environment Configuration (Example)
# NOTE: No real API keys or secrets are required for MVP synthetic demonstration.

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
DATABASE_URL=sqlite:///./fedcreditx.db

# Frontend Configuration
# Render frontend service only. Example: https://fedcreditx-api.onrender.com. No trailing slash. Changing it requires a frontend redeploy because rewrites are applied at build time.
BACKEND_URL=https://fedcreditx-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Controlled Demo Auditor Authentication (Evaluation Access Only)
DEMO_AUDITOR_ENABLED=false
DEMO_AUDITOR_EMAIL=
DEMO_AUDITOR_PASSWORD_HASH=
DEMO_AUDITOR_EXPIRES_AT=
