# FedCreditX .gitignore

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
# Python virtual environment internal libs (do not ignore TypeScript lib dirs)
venv/lib/
env/lib/
ENV/lib/
!**/frontend/**/lib/**
!**/lib/firebase.ts
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Data and Artifacts (Privacy Boundary)
backend/local_data/
backend/artifacts/
logs/
backend/logs/
*.sqlite
*.sqlite3
*.db
*.pt
*.pth

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
